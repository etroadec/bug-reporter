NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Comma-separated list of emails allowed to sign in to the admin portal (magic link).
# Required — if empty, nobody can access the portal.
ADMIN_EMAILS=you@example.com

# Public base URL of the admin portal, used to build the magic-link redirect.
# Required. Must match the admin URL and be allowlisted in Supabase Auth
# (Site URL + Redirect URLs). Do NOT rely on request headers for this.
NEXT_PUBLIC_SITE_URL=https://your-admin-domain.example.com
